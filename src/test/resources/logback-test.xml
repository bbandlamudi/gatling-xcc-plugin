<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%-5level] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for detailed logs -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/gatling-xcc.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Gatling framework logging -->
    <logger name="io.gatling" level="INFO" />
    <logger name="io.gatling.http.engine.response" level="INFO" />
    
    <!-- XCC Plugin logging - set to DEBUG for detailed troubleshooting -->
    <logger name="com.marklogic.gatling.xcc" level="DEBUG" />
    
    <!-- MarkLogic XCC library logging -->
    <logger name="com.marklogic.xcc" level="DEBUG" />
    
    <!-- Scala/Java logging -->
    <logger name="scala.tools" level="WARN" />
    <logger name="org.scalatest" level="INFO" />

    <!-- Root logger configuration -->
    <root level="WARN">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
